{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-6",
  "default_agent": "build",
  "enabled_providers": [
    "anthropic"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "baseURL": "{env:ANTHROPIC_BASE_URL}"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "bash": {
      "*": "allow"
    }
  },
  "tools": {
    "write": true,
    "edit": true,
    "bash": true,
    "webfetch": true,
    "websearch": true,
    "todoread": true,
    "todowrite": true
  }
}