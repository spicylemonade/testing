{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-6",
  "default_agent": "build",
  "enabled_providers": [
    "anthropic"
  ],
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}",
        "baseURL": "{env:ANTHROPIC_BASE_URL}"
      }
    }
  },
  "agent": {
    "build": {
      "description": "Primary implementation agent for Archivara research pipeline",
      "mode": "primary",
      "steps": 40,
      "permission": {
        "task": {
          "*": "allow"
        }
      }
    },
    "plan": {
      "description": "Planning-only mode for high-level strategy",
      "mode": "primary",
      "tools": {
        "write": false,
        "edit": false,
        "bash": false
      }
    }
  }
}