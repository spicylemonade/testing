{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hadamard668SupportState",
  "type": "object",
  "required": [
    "length",
    "weight",
    "support",
    "canonical_orbit",
    "periodic_autocorrelation_half",
    "autocorrelation_debt",
    "closest_target_distance",
    "max_defect_magnitude",
    "exact_hit",
    "psd_check"
  ],
  "properties": {
    "length": {
      "type": "integer",
      "minimum": 1
    },
    "weight": {
      "type": "integer",
      "minimum": 0
    },
    "support": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "canonical_orbit": {
      "type": "string"
    },
    "periodic_autocorrelation_half": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "autocorrelation_debt": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "closest_target_distance": {
      "type": "integer",
      "minimum": 0
    },
    "max_defect_magnitude": {
      "type": "integer",
      "minimum": 0
    },
    "exact_hit": {
      "type": "boolean"
    },
    "psd_check": {
      "type": "object",
      "required": [
        "sample_count",
        "min_value",
        "max_value",
        "nonnegative_with_tolerance",
        "tolerance"
      ],
      "properties": {
        "sample_count": {
          "type": "integer",
          "minimum": 0
        },
        "min_value": {
          "type": "number"
        },
        "max_value": {
          "type": "number"
        },
        "nonnegative_with_tolerance": {
          "type": "boolean"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
