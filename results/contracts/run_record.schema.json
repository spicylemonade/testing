{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hadamard668RunRecord",
  "type": "object",
  "required": [
    "branch",
    "instance_label",
    "method",
    "method_params",
    "seed_family",
    "deterministic_seed",
    "budget_steps",
    "matching_schedule",
    "accepted_moves",
    "visited_states",
    "unique_orbits",
    "orbit_collapse_ratio",
    "best_state",
    "best_step",
    "final_state",
    "exact_hit",
    "exact_hit_step",
    "elapsed_seconds",
    "snapshots"
  ],
  "properties": {
    "branch": {
      "type": "string",
      "enum": [
        "H1",
        "H2"
      ]
    },
    "instance_label": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "method_params": {
      "type": "object"
    },
    "seed_family": {
      "type": "string"
    },
    "deterministic_seed": {
      "type": "integer"
    },
    "budget_steps": {
      "type": "integer",
      "minimum": 1
    },
    "matching_schedule": {
      "type": "string"
    },
    "accepted_moves": {
      "type": "integer",
      "minimum": 0
    },
    "edge_evaluations": {
      "type": "integer",
      "minimum": 0
    },
    "variable_evaluations": {
      "type": "integer",
      "minimum": 0
    },
    "visited_states": {
      "type": "integer",
      "minimum": 1
    },
    "unique_orbits": {
      "type": "integer",
      "minimum": 1
    },
    "orbit_collapse_ratio": {
      "type": "number",
      "minimum": 0
    },
    "best_state": {
      "type": "object"
    },
    "best_step": {
      "type": "integer",
      "minimum": 0
    },
    "final_state": {
      "type": "object"
    },
    "exact_hit": {
      "type": "boolean"
    },
    "goal_hit": {
      "type": "boolean"
    },
    "exact_hit_step": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "goal_hit_step": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "snapshots": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
