            "enum": [
              -1,
              1
            ]
          }
        },
        "C": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              -1,
              1
            ]
          }
        },
        "D": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [
              -1,
              1
            ]
          }
        }
