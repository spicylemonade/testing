  "bridge_papers": [
    {
      "paperId": "banuelos1994",
      "title": "Brownian motion and the fundamental frequency of a drum",
      "connected_domains": ["Bloch constant theory", "Spectral geometry", "Probability/Brownian motion"],
      "transferable_technique": "Bañuelos and Carroll establish bounds on the expected exit time of Brownian motion from simply connected domains using inradius estimates. Any improvement in the constant relating exit time to inradius R (currently E[τ] ≤ C·R²) directly translates to bounds on B_u, since the inradius of f(D) equals B_f."
    },
    {
      "paperId": "bishop2007",
      "title": "Conformal welding and Koebe's theorem",
      "connected_domains": ["Bloch constant theory", "Quasiconformal mappings", "Teichmüller theory"],
      "transferable_technique": "Bishop's conformal welding existence theorem enables the construction of domains with prescribed boundary behavior (harmonically symmetric arcs). Carroll & Ortega-Cerdà used this to construct extremal domains for B_u upper bounds; further welding techniques from quasiconformal theory may constrain the extremal domain geometry."
    },
    {
      "paperId": "fedorov1985",
      "title": "On a variational problem of Chebotarev in the theory of capacity",
      "connected_domains": ["Bloch constant theory", "Potential theory", "Capacity optimization"],
      "transferable_technique": "Fedorov solved the Polya-Chebotarev problem for 4 symmetric points, finding the minimal-capacity continuum connecting them. This solution provides explicit conformal maps needed for the Carroll-Ortega-Cerdà upper bound construction. Extending to higher-order configurations could tighten upper bounds."
    },
    {
      "paperId": "baernsteinvinson1998",
      "title": "Local minimality results related to the Bloch and Landau constants",
      "connected_domains": ["Bloch constant theory", "Calculus of variations", "Symmetrization"],
      "transferable_technique": "Baernstein and Vinson proved that the Ahlfors-Grunsky conjectured extremal function gives a local minimum for B among coverings ramified only over lattice points. Their variational framework, based on symmetrization and rearrangement inequalities, could be adapted to characterize local minima for B_u."
    },
    {
      "paperId": "bonkmindayanagihara1997",
      "title": "Distortion theorems for Bloch functions",
      "connected_domains": ["Bloch constant theory", "Hyperbolic geometry", "Normal families"],
      "transferable_technique": "The Bonk-Minda-Yanagihara distortion theorem provides sharp bounds on |f'(z)| for Bloch functions in terms of the hyperbolic metric. For univalent functions, stronger distortion bounds hold (Koebe distortion theorem), and combining both frameworks could yield tighter B_u estimates."
    },
    {
      "paperId": "kudryavtsevasolodov2022",
      "title": "Inverse function theorem on holomorphic self-maps of a disc with two fixed points",
      "connected_domains": ["Bloch constant theory", "Fixed point theory", "Boundary behavior"],
      "transferable_technique": "Kudryavtseva and Solodov solve the sharp invertibility domain problem for self-maps of D with two fixed points, extending Landau's original approach. Their method of using angular derivative constraints at boundary fixed points provides a new route to Bloch-type lower bounds via Landau's framework."
    }
  ],
