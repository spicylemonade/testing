    "lp_feasible_triplet": {
      "description": "LP/feasible-triplet framework for rigorous lower and upper bounds",
      "papers": ["L2009", "Lueker2008", "H2024", "Rosenfeld2024", "D1994", "DP1995"],
      "key_idea": "Encode the LCS growth rate as a linear program over distributions on string-pair states. Feasible solutions to the primal give lower bounds; dual solutions give upper bounds."
    },
    "markov_chain_dfa": {
      "description": "Markov chain / DFA methods for lower bounds",
      "papers": ["D1994", "DP1995", "H2024", "KiwiSoto2008"],
      "key_idea": "Model the LCS matching process as a DFA reading string pairs. The Markov chain steady-state gives the matching rate, yielding a lower bound."
    },
    "particle_systems_frog_dynamics": {
      "description": "Interacting particle systems and frog dynamics",
      "papers": ["BukhCox2019", "BriggsEtAl2024", "Tiskin2022", "AggarwalEtAl2023"],
      "key_idea": "The LCS of periodic-vs-random strings can be computed via an interacting particle system (frog dynamics / PushTASEP). The stationary distribution determines gamma_W."
    },
    "statistical_mechanics_cavity": {
      "description": "Statistical mechanics, cavity methods, and Monte Carlo simulations",
      "papers": ["Bundschuh2001", "Tiskin2022"],
      "key_idea": "Map LCS to a disordered system ground state energy. Replica/cavity methods give estimates; multi-spin coding MC gives high-precision numerics."
    },
    "kpz_lpp_random_matrices": {
      "description": "KPZ universality, last-passage percolation, and random matrix connections",
      "papers": ["BaikDeiftJohansson1999", "PraehoferSpohn2001", "Borodin1999", "LemberMatzinger2009", "BaslingkerEtAl2024", "FerrarriOccelli2018", "Busani2021", "Sorensen2023"],
      "key_idea": "LCS maps to LPP in a random environment. The Bernoulli matching model (independent weights) is exactly solvable with Tracy-Widom fluctuations. Correlations in the true LCS model break integrability."
    },
    "information_theory_deletion_channel": {
      "description": "Information-theoretic connections and deletion channel capacity",
      "papers": ["Cheraghchi2019", "CheraghchiSTOC2018", "RubinsteinCon2023", "GuruswamiHeLi2021", "KashEtAl2011", "Tavakoli2021"],
      "key_idea": "Connection between LCS of random strings and binary deletion channel capacity. Upper bounds on capacity may yield upper bounds on gamma_2."
    }
