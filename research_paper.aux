\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Optimizer comparison.} (Left) Solution quality (predicted stability score) vs.\ number of mutations $k$ for beam search, greedy, and evolutionary optimizers. (Right) Optimization runtime scaling. Brute-force becomes infeasible for $k \geq 5$ with $K=50$ candidates, while beam search scales linearly.\relax }}{11}{figure.caption.18}\protected@file@percent }
\newlabel{fig:optimizers}{{5}{11}{\textbf {Optimizer comparison.} (Left) Solution quality (predicted stability score) vs.\ number of mutations $k$ for beam search, greedy, and evolutionary optimizers. (Right) Optimization runtime scaling. Brute-force becomes infeasible for $k \geq 5$ with $K=50$ candidates, while beam search scales linearly.\relax }{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {GPU memory usage} scales linearly with protein length and remains well below the 40\nobreakspace  {}GB A100 limit across all tested configurations.\relax }}{11}{figure.caption.19}\protected@file@percent }
