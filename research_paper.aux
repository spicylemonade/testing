\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Headline quantitative summary from the deterministic evidence pack. The startup-matrix tie is exact. The expanded falsifier suite overturns the original mechanism story by placing the blind packet gate above the RC-ranked design.\relax }}{13}{table.caption.6}\protected@file@percent }
\newlabel{tab:headline}{{3}{13}{Headline quantitative summary from the deterministic evidence pack. The startup-matrix tie is exact. The expanded falsifier suite overturns the original mechanism story by placing the blind packet gate above the RC-ranked design.\relax }{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Expanded 10-case falsifier matrix. Green cells denote successful startup; red cells denote failure. Text within each cell reports measured pre-handoff back-drive energy or chatter events. The important pattern is row-wise, not column-wise: the blind packet gate is the only design that reaches $10/10$ and the only one that avoids the measured fall/rise2 chatter event in \texttt  {fa\_004}. The nonaware design fails both leak-path cases, the mixed-conflict case, and remains weaker on collapse, consistent with its explicit pre-handoff branch join.\relax }}{13}{figure.caption.7}\protected@file@percent }
\newlabel{fig:falsifier}{{4}{13}{Expanded 10-case falsifier matrix. Green cells denote successful startup; red cells denote failure. Text within each cell reports measured pre-handoff back-drive energy or chatter events. The important pattern is row-wise, not column-wise: the blind packet gate is the only design that reaches $10/10$ and the only one that avoids the measured fall/rise2 chatter event in \texttt {fa\_004}. The nonaware design fails both leak-path cases, the mixed-conflict case, and remains weaker on collapse, consistent with its explicit pre-handoff branch join.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Median control energy under the repaired pre-handoff contract and the legacy full-window diagnostic. The full-window integral exaggerates every design by about $1.08\times 10^{10}$ because it continues to count post-handoff activity. The repaired metric exposes the actual pre-handoff ordering: \textsc  {RC-Ranked}and \textsc  {Blind Packet}are equal on the startup matrix, \textsc  {Nonaware}is the largest, and \textsc  {TC-Ranked}is the smallest. Theorem\nobreakspace  {}\ref {thm:ctrl} explains this ordering through effective control conductance.\relax }}{14}{figure.caption.8}\protected@file@percent }
\newlabel{fig:accounting}{{5}{14}{Median control energy under the repaired pre-handoff contract and the legacy full-window diagnostic. The full-window integral exaggerates every design by about $1.08\times 10^{10}$ because it continues to count post-handoff activity. The repaired metric exposes the actual pre-handoff ordering: \RCRanked and \Blind are equal on the startup matrix, \Nonaware is the largest, and \TCRanked is the smallest. Theorem~\ref {thm:ctrl} explains this ordering through effective control conductance.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}Corrected Metric Accounting Restores Interpretability}{14}{subsection.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Ablation tradeoffs across the deterministic evidence pack. Startup-matrix success is identical for all five designs, so the global envelope is unchanged. The expanded falsifier suite then becomes the deciding discriminator, where \textsc  {Blind Packet}is best and \textsc  {TC-Ranked}is second. The control-energy panel shows why \textsc  {TC-Ranked}remains valuable as a secondary result: it achieves nearly the same adversarial boundary with the lowest pre-handoff control cost.\relax }}{15}{figure.caption.9}\protected@file@percent }
\newlabel{fig:tradeoff}{{6}{15}{Ablation tradeoffs across the deterministic evidence pack. Startup-matrix success is identical for all five designs, so the global envelope is unchanged. The expanded falsifier suite then becomes the deciding discriminator, where \Blind is best and \TCRanked is second. The control-energy panel shows why \TCRanked remains valuable as a secondary result: it achieves nearly the same adversarial boundary with the lowest pre-handoff control cost.\relax }{figure.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Ablation Tradeoffs and Design Guidance}{15}{subsection.7.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5}Robustness: the Boundary Survives Randomized Perturbation}{15}{subsection.7.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Startup probability with Wilson 95\% intervals from 24 randomized runs per design-case. \texttt  {fa\_001} remains a clean separator against \textsc  {Fixed}, and \texttt  {fa\_005} remains a clean separator against \textsc  {Nonaware}. \texttt  {fa\_004} and \texttt  {sm\_015} show that all five designs are robust in the chatter-repair case and in a representative primary-matrix null case. The packet-gated family therefore preserves its advantage under modest parameter jitter.\relax }}{16}{figure.caption.10}\protected@file@percent }
\newlabel{fig:robustness}{{7}{16}{Startup probability with Wilson 95\% intervals from 24 randomized runs per design-case. \texttt {fa\_001} remains a clean separator against \Fixed , and \texttt {fa\_005} remains a clean separator against \Nonaware . \texttt {fa\_004} and \texttt {sm\_015} show that all five designs are robust in the chatter-repair case and in a representative primary-matrix null case. The packet-gated family therefore preserves its advantage under modest parameter jitter.\relax }{figure.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Selected robustness summary. Grouped rows are used when multiple designs share identical startup probability. The deterministic boundary remains visible after parameter jitter.\relax }}{16}{table.caption.11}\protected@file@percent }
\newlabel{tab:robustness}{{4}{16}{Selected robustness summary. Grouped rows are used when multiple designs share identical startup probability. The deterministic boundary remains visible after parameter jitter.\relax }{table.caption.11}{}}
