\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Energy drift versus timestep for Euler, Velocity Verlet, and leapfrog integrators. $N=100$, 5000 steps, $\varepsilon =0.5$. Symplectic methods show quadratic convergence ($\mathcal  {O}(\Delta t^2)$) for small\nobreakspace  {}$\Delta t$, while Euler exhibits linear convergence ($\mathcal  {O}(\Delta t)$). Both symplectic methods break down at $\Delta t\geq 0.05$ due to exceeding the stability limit.\relax }}{7}{figure.caption.9}\protected@file@percent }
\newlabel{fig:integrator_comparison}{{1}{7}{Energy drift versus timestep for Euler, Velocity Verlet, and leapfrog integrators. $N=100$, 5000 steps, $\soft =0.5$. Symplectic methods show quadratic convergence ($\bigO (\dt ^2)$) for small~$\dt $, while Euler exhibits linear convergence ($\bigO (\dt )$). Both symplectic methods break down at $\dt \geq 0.05$ due to exceeding the stability limit.\relax }{figure.caption.9}{}}
