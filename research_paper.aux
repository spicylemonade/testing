\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Best exact forced fractions in the larger logged search families.} Each bar is the exact best forced fraction recorded in the repository for a family that would already satisfy the score target if it forced fully. The dashed horizontal line marks full forcing. None of the families reaches that line, and none yields a promoted exact-valid family. The error bars have zero width because the plot shows exact recorded maxima, not estimated averages.\relax }}{21}{figure.caption.10}\protected@file@percent }
\newlabel{fig:search}{{7}{21}{\textbf {Best exact forced fractions in the larger logged search families.} Each bar is the exact best forced fraction recorded in the repository for a family that would already satisfy the score target if it forced fully. The dashed horizontal line marks full forcing. None of the families reaches that line, and none yields a promoted exact-valid family. The error bars have zero width because the plot shows exact recorded maxima, not estimated averages.\relax }{figure.caption.10}{}}
