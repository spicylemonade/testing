\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Implemented H1 pipeline.} The state always remains in the shared $q/s$ representation, so any difference between H1 and the non-CA baselines comes from the update rule rather than from a different search space. Raw packet pressure is computed from exact one-packet defect deltas plus spill penalties; coupled pressure then adds same-channel and cross-channel neighborhood effects plus refractory memory. The continuation gate is external to the update rule: exact hit first, otherwise H1 must strictly beat every matched baseline on support and defect magnitude.\relax }}{8}{figure.caption.6}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{8}{\textbf {Implemented H1 pipeline.} The state always remains in the shared $q/s$ representation, so any difference between H1 and the non-CA baselines comes from the update rule rather than from a different search space. Raw packet pressure is computed from exact one-packet defect deltas plus spill penalties; coupled pressure then adds same-channel and cross-channel neighborhood effects plus refractory memory. The continuation gate is external to the update rule: exact hit first, otherwise H1 must strictly beat every matched baseline on support and defect magnitude.\relax }{figure.caption.6}{}}
\newlabel{eq:raw-pressure}{{16}{8}{Pressure functions and design rationale}{equation.4.16}{}}
\newlabel{eq:coupled-pressure}{{17}{8}{Pressure functions and design rationale}{equation.4.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Direct one-packet locality scan on the canonical frontier seed.} Left: distribution of the number of lag coefficients changed by a single packet flip. The median footprint is $51$ lags out of $166$, with maximum $83$, so a ``local'' one-packet action is typically global in effect. Middle: exhaustive score comparison over all $334$ packets. No packet improves the shared scalar proxy; one packet is neutral. Right: no packet lowers defect support; $333$ packets raise it. This finite computation is the direct evidence behind Proposition\nobreakspace  {}\ref {prop:one-packet-freeze}.\relax }}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:locality-scan}{{3}{9}{\textbf {Direct one-packet locality scan on the canonical frontier seed.} Left: distribution of the number of lag coefficients changed by a single packet flip. The median footprint is $51$ lags out of $166$, with maximum $83$, so a ``local'' one-packet action is typically global in effect. Middle: exhaustive score comparison over all $334$ packets. No packet improves the shared scalar proxy; one packet is neutral. Right: no packet lowers defect support; $333$ packets raise it. This finite computation is the direct evidence behind Proposition~\ref {prop:one-packet-freeze}.\relax }{figure.caption.7}{}}
