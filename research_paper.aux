\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Problem objects and overall program flow}{12}{subsection.7.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Exact objects that define the search problem. (a) The H1 target half-autocorrelation vector $\tau $ from the unresolved length-$167$, weight-$80$ cyclic obstruction of \citet  {constantine2025cyclic}. The branch objective is the exact $\ell _1$ distance to this vector, not an approximate proxy. (b) The signed nonzero combined aperiodic defects of the published mod-$64$ order-$668$ seed from \citet  {eliahou2025mod64}. The best available modulus is $64$ before degradation; the real H2 test begins only after a deterministic $s_{41}$ flip reduces that modulus to $16$.\relax }}{13}{figure.caption.4}\protected@file@percent }
\newlabel{fig:problem-objects}{{2}{13}{Exact objects that define the search problem. (a) The H1 target half-autocorrelation vector $\tau $ from the unresolved length-$167$, weight-$80$ cyclic obstruction of \citet {constantine2025cyclic}. The branch objective is the exact $\ell _1$ distance to this vector, not an approximate proxy. (b) The signed nonzero combined aperiodic defects of the published mod-$64$ order-$668$ seed from \citet {eliahou2025mod64}. The best available modulus is $64$ before degradation; the real H2 test begins only after a deterministic $s_{41}$ flip reduces that modulus to $16$.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}H1 fails on both the control and the target}{13}{subsection.7.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}H2 supplies no advantage on the real order-668 task}{13}{subsection.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Program flow from the original prompt to the validated claim. The executed packet first interprets ``cellar automata'' as cellular automata and instantiates two branches: H1 on the exact $167/80$ cyclic obstruction and H2 on the published mod-$64$ seed. Each branch is paired with a matched same-space non-CA baseline and with two negative controls. Both executed branches fail the registered gates, so the final evidence gate allows only a narrow no-go claim. The literal-cellar pushdown concept remains a reserve branch with no experimental credit.\relax }}{14}{figure.caption.5}\protected@file@percent }
\newlabel{fig:program-flow}{{3}{14}{Program flow from the original prompt to the validated claim. The executed packet first interprets ``cellar automata'' as cellular automata and instantiates two branches: H1 on the exact $167/80$ cyclic obstruction and H2 on the published mod-$64$ seed. Each branch is paired with a matched same-space non-CA baseline and with two negative controls. Both executed branches fail the registered gates, so the final evidence gate allows only a narrow no-go claim. The literal-cellar pushdown concept remains a reserve branch with no experimental credit.\relax }{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Reproducibility and the exact meaning of the no-go claim}{14}{subsection.7.4}\protected@file@percent }
