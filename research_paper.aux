\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Timing benchmark.} (Left) Heatmap of total pipeline time (seconds) as a function of protein length and mutation count $k$. All configurations complete in under 46 seconds. (Right) Time breakdown for a 300-residue protein across different $k$ values, showing that ESM-2 scoring and epistasis computation dominate runtime.\relax }}{10}{figure.caption.17}\protected@file@percent }
\newlabel{fig:timing}{{4}{10}{\textbf {Timing benchmark.} (Left) Heatmap of total pipeline time (seconds) as a function of protein length and mutation count $k$. All configurations complete in under 46 seconds. (Right) Time breakdown for a 300-residue protein across different $k$ values, showing that ESM-2 scoring and epistasis computation dominate runtime.\relax }{figure.caption.17}{}}
