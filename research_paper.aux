\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Construction and frontier geometry.} Left: the initial $5\times 11$ block of Kimberling's array. The first row and first column determine the whole array multiplicatively. Right: the step-$n$ frontier structure. The set $\mathcal  {P}_n=\mathcal  {R}_n\mathcal  {C}_n$ contains every positive integer below $c_{n+1}$ except the first missing value $r_{n+1}$; after adjoining $r_{n+1}$, that single hole is filled by the trivial representation $r_{n+1}=r_{n+1}\cdot 1$, so the next missing value remains $c_{n+1}$. Proposition\nobreakspace  {}\ref {prop:interleave} and Corollary\nobreakspace  {}\ref {cor:anchor} then force $r_n<c_n<r_{n+1}$ and identify the previous column term as the unique anchor inside the row gap.\relax }}{11}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:construction}{{1}{11}{\textbf {Construction and frontier geometry.} Left: the initial $5\times 11$ block of Kimberling's array. The first row and first column determine the whole array multiplicatively. Right: the step-$n$ frontier structure. The set $\Pset _n=\R _n\Cset _n$ contains every positive integer below $c_{n+1}$ except the first missing value $r_{n+1}$; after adjoining $r_{n+1}$, that single hole is filled by the trivial representation $r_{n+1}=r_{n+1}\cdot 1$, so the next missing value remains $c_{n+1}$. Proposition~\ref {prop:interleave} and Corollary~\ref {cor:anchor} then force $r_n<c_n<r_{n+1}$ and identify the previous column term as the unique anchor inside the row gap.\relax }{figure.caption.1}{}}
