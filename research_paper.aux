\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Convergence Study}{9}{subsection.6.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Convergence of maximum energy drift $|\Delta E/E_0|_{\max }$ with timestep $\Delta t$ on a log-log scale for the Kepler orbit problem (10 orbits). The measured slope of 2.00 for leapfrog confirms second-order convergence; the Yoshida slope of 3.98 (excluding the machine-precision-limited $\Delta t = 10^{-4}$ point) confirms fourth-order convergence, in agreement with theoretical predictions \citep  {yoshida1990, hairer2004}.\relax }}{9}{figure.caption.19}\protected@file@percent }
\newlabel{fig:convergence}{{4}{9}{Convergence of maximum energy drift $|\Delta E/E_0|_{\max }$ with timestep $\Delta t$ on a log-log scale for the Kepler orbit problem (10 orbits). The measured slope of 2.00 for leapfrog confirms second-order convergence; the Yoshida slope of 3.98 (excluding the machine-precision-limited $\Delta t = 10^{-4}$ point) confirms fourth-order convergence, in agreement with theoretical predictions \citep {yoshida1990, hairer2004}.\relax }{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Barnes--Hut Accuracy vs.\ Opening Angle}{9}{subsection.6.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Convergence study: maximum energy drift versus timestep. Measured convergence orders agree with theory (2nd for leapfrog, 4th for Yoshida). Bold indicates the best drift at each $\Delta t$.\relax }}{10}{table.caption.20}\protected@file@percent }
\newlabel{tab:convergence}{{6}{10}{Convergence study: maximum energy drift versus timestep. Measured convergence orders agree with theory (2nd for leapfrog, 4th for Yoshida). Bold indicates the best drift at each $\Delta t$.\relax }{table.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Barnes--Hut accuracy--speed trade-off as a function of opening angle $\theta $ for $N = 1000$ Plummer sphere particles. Smaller $\theta $ yields higher accuracy (lower RMS force error) at greater computational cost. The standard choice $\theta = 0.5$ provides sub-percent force accuracy with a $1.64\times $ speedup over $\theta = 0.3$, representing a practical compromise for most applications.\relax }}{10}{figure.caption.21}\protected@file@percent }
\newlabel{fig:theta}{{5}{10}{Barnes--Hut accuracy--speed trade-off as a function of opening angle $\theta $ for $N = 1000$ Plummer sphere particles. Smaller $\theta $ yields higher accuracy (lower RMS force error) at greater computational cost. The standard choice $\theta = 0.5$ provides sub-percent force accuracy with a $1.64\times $ speedup over $\theta = 0.3$, representing a practical compromise for most applications.\relax }{figure.caption.21}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Barnes--Hut accuracy versus opening angle $\theta $ for $N = 1000$. RMS and maximum force errors are relative to exact brute-force computation. Bold indicates best accuracy.\relax }}{10}{table.caption.22}\protected@file@percent }
\newlabel{tab:theta}{{7}{10}{Barnes--Hut accuracy versus opening angle $\theta $ for $N = 1000$. RMS and maximum force errors are relative to exact brute-force computation. Bold indicates best accuracy.\relax }{table.caption.22}{}}
