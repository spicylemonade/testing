\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Instructions per decoded byte for each implementation. AVX-512 VBMI achieves 0.42 instructions per byte---a $25\times $ improvement in instruction efficiency over scalar.\relax }}{12}{figure.caption.19}\protected@file@percent }
\newlabel{fig:ipb}{{3}{12}{Instructions per decoded byte for each implementation. AVX-512 VBMI achieves 0.42 instructions per byte---a $25\times $ improvement in instruction efficiency over scalar.\relax }{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.5}Pipeline Comparison}{12}{subsection.6.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Production Gap Visualization}{12}{subsection.6.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.7}Correctness Validation}{12}{subsection.6.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces SIMD decode pipeline stage comparison. AVX-512 VBMI reduces the lookup stage from 3\nobreakspace  {}instructions to 1 (\texttt  {vpermb}\xspace  ) and the packing stage from 2 to 1 (\texttt  {vpmultishiftqb}\xspace  ), while doubling the processed block size.\relax }}{13}{figure.caption.20}\protected@file@percent }
\newlabel{fig:pipeline}{{4}{13}{SIMD decode pipeline stage comparison. AVX-512 VBMI reduces the lookup stage from 3~instructions to 1 (\vpermb ) and the packing stage from 2 to 1 (\vpmultishiftqb ), while doubling the processed block size.\relax }{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Throughput comparison across production Base64 implementations. Scalar implementations (gray) cluster at 0.3--1.2\nobreakspace  {}GB/s\xspace  . SIMD implementations (colored) range from 2.5 to 10+\nobreakspace  {}GB/s\xspace  , representing a 5--20$\times $ performance gap that remains unexploited in most production software.\relax }}{13}{figure.caption.21}\protected@file@percent }
\newlabel{fig:production_gap}{{5}{13}{Throughput comparison across production Base64 implementations. Scalar implementations (gray) cluster at 0.3--1.2~\GBs . SIMD implementations (colored) range from 2.5 to 10+~\GBs , representing a 5--20$\times $ performance gap that remains unexploited in most production software.\relax }{figure.caption.21}{}}
