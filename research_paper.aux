\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Scalability analysis. Left: throughput vs.\ structural density across datasets, showing strong negative correlation ($r = -0.82$) between boundaries per byte and throughput. Right: predicted multi-thread scaling from Amdahl's law analysis, showing the $3.1\times $ ceiling imposed by Phase\nobreakspace  {}2's 31.2\% sequential fraction. Memory bandwidth ($\sim $15$\,\text  {GB/s}$) is not the limiting factor.\relax }}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:scalability}{{4}{11}{Scalability analysis. Left: throughput vs.\ structural density across datasets, showing strong negative correlation ($r = -0.82$) between boundaries per byte and throughput. Right: predicted multi-thread scaling from Amdahl's law analysis, showing the $3.1\times $ ceiling imposed by Phase~2's 31.2\% sequential fraction. Memory bandwidth ($\sim $15$\gbps $) is not the limiting factor.\relax }{figure.caption.10}{}}
\newlabel{fig:scalability@cref}{{[figure][4][]4}{[1][9][]11}}
