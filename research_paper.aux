\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Log-log scaling of wall-clock time per step for direct (vectorized $\mathcal  {O}(N^2)$) and Barnes--Hut ($\theta =0.5$) force computation. Fitted exponents: 1.67 (direct) and 1.34 (Barnes--Hut). The pure-Python Barnes--Hut does not outperform NumPy-vectorized direct summation until $N \gtrsim 5000$.\relax }}{8}{figure.caption.11}\protected@file@percent }
\newlabel{fig:scaling}{{2}{8}{Log-log scaling of wall-clock time per step for direct (vectorized $\bigO (N^2)$) and Barnes--Hut ($\theta =0.5$) force computation. Fitted exponents: 1.67 (direct) and 1.34 (Barnes--Hut). The pure-Python Barnes--Hut does not outperform NumPy-vectorized direct summation until $N \gtrsim 5000$.\relax }{figure.caption.11}{}}
