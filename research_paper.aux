\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Phase 6 route audits beyond the corridor pilot. \textbf  {a}, forcing hit rates with $95\%$ Wilson intervals: H4 typed interfaces and H5 shell words both stay at zero, while the aggregated H5 direct comparator remains positive. \textbf  {b}, H6 parity: the only positive schedule is the aperiodic word $\mathrm  {SDP}$ at score $13/7$, and the exhaustive controller bank recovers the same best score rather than a stronger one. \textbf  {c}, metastability scatter: high closure time does not predict score, and the matched direct representative $\mathrm  {SDP}$ lies inside a four-word tie rather than below it.\relax }}{21}{figure.caption.17}\protected@file@percent }
\newlabel{fig:route-audits}{{6}{21}{Phase 6 route audits beyond the corridor pilot. \textbf {a}, forcing hit rates with $95\%$ Wilson intervals: H4 typed interfaces and H5 shell words both stay at zero, while the aggregated H5 direct comparator remains positive. \textbf {b}, H6 parity: the only positive schedule is the aperiodic word $\mathrm {SDP}$ at score $13/7$, and the exhaustive controller bank recovers the same best score rather than a stronger one. \textbf {c}, metastability scatter: high closure time does not predict score, and the matched direct representative $\mathrm {SDP}$ lies inside a four-word tie rather than below it.\relax }{figure.caption.17}{}}
