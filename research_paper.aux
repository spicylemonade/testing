\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Recovered order-$668$ frontier seed.} The upper strips show the exact binary $q$ and $s$ sequences decoded from the published run-length encoding of \citet  [Fact 3.1]{eliahou2025_64mod668}. The lower panel shows the combined correlation coefficients $c_k$ from \eqref  {eq:ck}. Only $13$ of the $166$ nonzero-lag coefficients are nonzero; their exact values are listed in \eqref  {eq:frontier-coeffs}. This figure is not a search result from the present paper. It is the fixed starting object that every order-$668$ experiment in this study uses.\relax }}{5}{figure.caption.1}\protected@file@percent }
