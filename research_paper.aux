\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Left: Single-thread speedup over zlib for all implementations across five data categories. \textsc  {FlashDeflate}{} (1T) consistently exceeds the 2--5$\times $ target range, achieving 4.4--4.8$\times $. Right: Multi-thread scaling of \textsc  {FlashDeflate}{} on the Silesia corpus, demonstrating near-linear scaling to 4 threads and diminishing returns beyond 8 threads due to memory bandwidth saturation.\relax }}{12}{figure.caption.10}\protected@file@percent }
\newlabel{fig:speedup}{{4}{12}{Left: Single-thread speedup over zlib for all implementations across five data categories. \sysname {} (1T) consistently exceeds the 2--5$\times $ target range, achieving 4.4--4.8$\times $. Right: Multi-thread scaling of \sysname {} on the Silesia corpus, demonstrating near-linear scaling to 4 threads and diminishing returns beyond 8 threads due to memory bandwidth saturation.\relax }{figure.caption.10}{}}
\newlabel{fig:speedup@cref}{{[figure][4][]4}{[1][10][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Left: Ablation waterfall showing cumulative throughput as each optimization technique is enabled. The baseline is a libdeflate-class implementation (1050\nobreakspace  {}MB/s{}). Each bar shows the incremental throughput contribution. Right: Cycle budget decomposition showing the relative cost of each bottleneck in the baseline zlib implementation.\relax }}{12}{figure.caption.11}\protected@file@percent }
\newlabel{fig:ablation}{{5}{12}{Left: Ablation waterfall showing cumulative throughput as each optimization technique is enabled. The baseline is a libdeflate-class implementation (1050~\MBs {}). Each bar shows the incremental throughput contribution. Right: Cycle budget decomposition showing the relative cost of each bottleneck in the baseline zlib implementation.\relax }{figure.caption.11}{}}
\newlabel{fig:ablation@cref}{{[figure][5][]5}{[1][11][]12}}
