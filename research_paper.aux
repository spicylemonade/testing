\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Selected full witness hypergraphs for late baseline record gaps.} Left: total admissible factor pairs and the numbers of distinct row and column factors used in gaps $21$, $25$, $28$, and $30$, from \artifact  {results/analysis/full\_witness\_hypergraphs\_gap21\_25\_28\_30.json}. Right: multiplicity histograms for the same gaps. Even after full enumeration, the intervals remain singleton-dominated and use nearly as many distinct factors as there are witness pairs. This is evidence against a low-description frontier certificate.\relax }}{16}{figure.caption.6}\protected@file@percent }
\newlabel{fig:hypergraph}{{5}{16}{\textbf {Selected full witness hypergraphs for late baseline record gaps.} Left: total admissible factor pairs and the numbers of distinct row and column factors used in gaps $21$, $25$, $28$, and $30$, from \artifact {results/analysis/full\_witness\_hypergraphs\_gap21\_25\_28\_30.json}. Right: multiplicity histograms for the same gaps. Even after full enumeration, the intervals remain singleton-dominated and use nearly as many distinct factors as there are witness pairs. This is evidence against a low-description frontier certificate.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}What the computational evidence now says}{16}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Exact identities behind the archived update-order runs.} Left: the \texttt  {row\_immediate} sequence pair lies exactly on the diagonal when plotted against the baseline, because Proposition\nobreakspace  {}\ref {prop:rowimmediate} proves that the rule is identical to the original recurrence. Right: the \texttt  {column\_immediate} pair lies exactly on the axis-swapped diagonal because Proposition\nobreakspace  {}\ref {prop:swap} proves that it simply exchanges the roles of the two border sequences. These runs are therefore code-level consistency checks, not genuine robustness experiments.\relax }}{17}{figure.caption.8}\protected@file@percent }
\newlabel{fig:variants}{{6}{17}{\textbf {Exact identities behind the archived update-order runs.} Left: the \texttt {row\_immediate} sequence pair lies exactly on the diagonal when plotted against the baseline, because Proposition~\ref {prop:rowimmediate} proves that the rule is identical to the original recurrence. Right: the \texttt {column\_immediate} pair lies exactly on the axis-swapped diagonal because Proposition~\ref {prop:swap} proves that it simply exchanges the roles of the two border sequences. These runs are therefore code-level consistency checks, not genuine robustness experiments.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Remaining limitations}{17}{subsection.8.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Distribution of all first-row gaps through the archived million-step run.} Left: exact frequencies of $g_n=r_{n+1}-r_n$ for $1\le n<10^6$. Right: the empirical survival function on a logarithmic vertical scale. The distribution is concentrated on moderate values but has a visible long tail; finite data alone do not distinguish a bounded tail from a slowly moving frontier.\relax }}{18}{figure.caption.9}\protected@file@percent }
\newlabel{fig:distribution}{{7}{18}{\textbf {Distribution of all first-row gaps through the archived million-step run.} Left: exact frequencies of $g_n=r_{n+1}-r_n$ for $1\le n<10^6$. Right: the empirical survival function on a logarithmic vertical scale. The distribution is concentrated on moderate values but has a visible long tail; finite data alone do not distinguish a bounded tail from a slowly moving frontier.\relax }{figure.caption.9}{}}
