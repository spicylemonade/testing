\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {StabOpt{} pipeline overview.} Stage\nobreakspace  {}1: ESM-2 masked marginal scoring of all $L \times 19$ single mutations ($\sim $18\,s for a 108-residue protein). Stage\nobreakspace  {}2: Pairwise epistasis estimation for top-$N$ candidates via conditional log-likelihood shifts, filtered by structural proximity ($\sim $17\,s). Stage\nobreakspace  {}3: Combinatorial optimization via beam search, greedy, or evolutionary search ($\sim $3\,s). Stage\nobreakspace  {}4: ProteinMPNN consensus re-ranking of top candidates ($<$1\,s). Timing shown for a 108-residue protein on an NVIDIA A100 GPU.\relax }}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{4}{\textbf {\stabopt {} pipeline overview.} Stage~1: ESM-2 masked marginal scoring of all $L \times 19$ single mutations ($\sim $18\,s for a 108-residue protein). Stage~2: Pairwise epistasis estimation for top-$N$ candidates via conditional log-likelihood shifts, filtered by structural proximity ($\sim $17\,s). Stage~3: Combinatorial optimization via beam search, greedy, or evolutionary search ($\sim $3\,s). Stage~4: ProteinMPNN consensus re-ranking of top candidates ($<$1\,s). Timing shown for a 108-residue protein on an NVIDIA A100 GPU.\relax }{figure.caption.5}{}}
