\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}Canonical frontier batch: no exact hit and no best-objective gain}{15}{subsection.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Matched solved controls.} Left: exact-hit matrix on the order-$20$ and order-$28$ control perturbations, with per-run objective evaluations annotated in each cell. Right: exact-hit rate across the two controls together with median evaluation use. H1 reaches exactness on both controls, which rules out a trivial implementation failure, but greedy and tabu do so as well. The control batch therefore validates executability and fair accounting rather than proving a CA-specific advantage.\relax }}{16}{figure.caption.9}\protected@file@percent }
\newlabel{fig:controls}{{4}{16}{\textbf {Matched solved controls.} Left: exact-hit matrix on the order-$20$ and order-$28$ control perturbations, with per-run objective evaluations annotated in each cell. Right: exact-hit rate across the two controls together with median evaluation use. H1 reaches exactness on both controls, which rules out a trivial implementation failure, but greedy and tabu do so as well. The control batch therefore validates executability and fair accounting rather than proving a CA-specific advantage.\relax }{figure.caption.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Canonical frontier batch summary.} Terminal triples are reported as median $[\min ,\max ]$ across completed restarts. The exact-hit rate intervals again only expose uncertainty from very small restart counts.\relax }}{16}{table.caption.12}\protected@file@percent }
\newlabel{tab:frontier}{{3}{16}{\textbf {Canonical frontier batch summary.} Terminal triples are reported as median $[\min ,\max ]$ across completed restarts. The exact-hit rate intervals again only expose uncertainty from very small restart counts.\relax }{table.caption.12}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Diffusion versus paralysis under parameter variation}{16}{subsection.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Canonical frontier batch.} Left and center: each point is one method run from the same published seed under the same nominal budget, restart policy, and packet basis. H1 attains a lower terminal max defect and lower terminal $l_1$ than the seed only after diffusing support far above the seed support of $13$. Greedy and simulated annealing remain pinned to the seed. Right: wall-clock time versus reported objective evaluations. H1 is substantially slower despite fewer objective evaluations, reflecting the heavier internal field computation tracked separately by the CA metadata.\relax }}{17}{figure.caption.11}\protected@file@percent }
\newlabel{fig:frontier}{{5}{17}{\textbf {Canonical frontier batch.} Left and center: each point is one method run from the same published seed under the same nominal budget, restart policy, and packet basis. H1 attains a lower terminal max defect and lower terminal $l_1$ than the seed only after diffusing support far above the seed support of $13$. Greedy and simulated annealing remain pinned to the seed. Right: wall-clock time versus reported objective evaluations. H1 is substantially slower despite fewer objective evaluations, reflecting the heavier internal field computation tracked separately by the CA metadata.\relax }{figure.caption.11}{}}
