\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Median latency (ns) for all algorithms on 64-bit uniform random inputs. Error bars show the $[p_5, p_{95}]$ range across 50 trials. The combined algorithm achieves the lowest latency at 86.6\,ns, a 13.7\% improvement over Stein's classic (100.4\,ns) and a 2.0$\times $ improvement over the Euclidean algorithm (175.3\,ns).\relax }}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:64bit-uniform}{{1}{9}{Median latency (ns) for all algorithms on 64-bit uniform random inputs. Error bars show the $[p_5, p_{95}]$ range across 50 trials. The combined algorithm achieves the lowest latency at 86.6\,ns, a 13.7\% improvement over Stein's classic (100.4\,ns) and a 2.0$\times $ improvement over the Euclidean algorithm (175.3\,ns).\relax }{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Statistical comparison: Combined vs.\ Stein's Classic across all distributions. All speedups are statistically significant with $p < 10^{-15}$ and effect sizes well above the ``large'' threshold ($d > 0.8$).\relax }}{9}{table.caption.8}\protected@file@percent }
\newlabel{tab:statistics}{{2}{9}{Statistical comparison: Combined vs.\ Stein's Classic across all distributions. All speedups are statistically significant with $p < 10^{-15}$ and effect sizes well above the ``large'' threshold ($d > 0.8$).\relax }{table.caption.8}{}}
