\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Base64 decode throughput across implementations and payload sizes. The scalar baseline is measured; SIMD targets are projected from instruction analysis and published data. The AVX-512 VBMI decoder approaches DRAM bandwidth limits for large payloads. The simdutf AVX2 reference line (dashed) shows the current production state-of-the-art.\relax }}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:throughput}{{1}{10}{Base64 decode throughput across implementations and payload sizes. The scalar baseline is measured; SIMD targets are projected from instruction analysis and published data. The AVX-512 VBMI decoder approaches DRAM bandwidth limits for large payloads. The simdutf AVX2 reference line (dashed) shows the current production state-of-the-art.\relax }{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Speedup Analysis}{11}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Speedup over the scalar baseline by ISA and payload size. The dashed red line indicates the $5\times $ target. All AVX2 and AVX-512 implementations exceed $5\times $ for payloads $\geq 1$\nobreakspace  {}KB. The SVE 256-bit decoder meets the $5\times $ target for payloads $\geq 4$\nobreakspace  {}KB.\relax }}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:speedup}{{2}{11}{Speedup over the scalar baseline by ISA and payload size. The dashed red line indicates the $5\times $ target. All AVX2 and AVX-512 implementations exceed $5\times $ for payloads $\geq 1$~KB. The SVE 256-bit decoder meets the $5\times $ target for payloads $\geq 4$~KB.\relax }{figure.caption.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Speedup summary for target payload range (1\nobreakspace  {}KB--10\nobreakspace  {}MB). ``vs.\ Production'' uses the representative 0.5\nobreakspace  {}GB/s\xspace  scalar baseline from the production survey.\relax }}{11}{table.caption.18}\protected@file@percent }
\newlabel{tab:speedup_summary}{{5}{11}{Speedup summary for target payload range (1~KB--10~MB). ``vs.\ Production'' uses the representative 0.5~\GBs scalar baseline from the production survey.\relax }{table.caption.18}{}}
