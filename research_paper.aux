\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Kepler orbit validation with the leapfrog integrator ($e = 0.5$, $\Delta t = T/20{,}000$, 10 orbital periods). Panels show the relative orbit trajectory, relative energy error $\Delta E / E$ versus time, separation versus time, and energy oscillation detail. Maximum $|\Delta E/E| = 2.63 \times 10^{-7}$ confirms bounded, non-drifting energy error characteristic of symplectic integration. \relax }}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:kepler}{{1}{7}{Kepler orbit validation with the leapfrog integrator ($e = 0.5$, $\Delta t = T/20{,}000$, 10 orbital periods). Panels show the relative orbit trajectory, relative energy error $\Delta E / E$ versus time, separation versus time, and energy oscillation detail. Maximum $|\Delta E/E| = 2.63 \times 10^{-7}$ confirms bounded, non-drifting energy error characteristic of symplectic integration. \relax }{figure.caption.7}{}}
