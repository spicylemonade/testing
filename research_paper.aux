\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Research pipeline and claim hierarchy. The repository first locks the arithmetic meaning of the problem, then separates the proof-complete periodic-gap lane from the sparse empirical lane. Exact certificates, not finite-window fits, are the gate into theorem language. This separation is the methodological backbone of the paper: it is what allows the final writeup to keep the rational periodic-gap theorem and the sparse quadratic examples in the same article without conflating proof, certificate, and exact holdout evidence.}}{3}{figure.8}\protected@file@percent }
\newlabel{fig:pipeline}{{1}{3}{Research pipeline and claim hierarchy. The repository first locks the arithmetic meaning of the problem, then separates the proof-complete periodic-gap lane from the sparse empirical lane. Exact certificates, not finite-window fits, are the gate into theorem language. This separation is the methodological backbone of the paper: it is what allows the final writeup to keep the rational periodic-gap theorem and the sparse quadratic examples in the same article without conflating proof, certificate, and exact holdout evidence}{figure.8}{}}
\newlabel{fig:pipeline@cref}{{[figure][1][]1}{[1][2][]3}}
\@writefile{toc}{\contentsline {paragraph}{Symbolic linear recurrence, S-adic structure, and central sets.}{3}{section*.12}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Generalized polynomials and self-matching.}{3}{section*.13}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Skolem--Mahler--Lech rigidity.}{3}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Curated positioning against the actual nearby branches, rather than the raw lexical watchlist. The closest technical neighbors solve different tasks: quadratic Beatty decidability studies numeration-definable Beatty relations rather than exact value recurrences \citep  {schaeffer2024,hieronymi2021,baranwal2021}; symbolic linear recurrence and central-set work study words, return words, or IP-set structure rather than the ordered integer value sequence \citep  {durand1998,durand2000,durand2003,bucci2013}; generalized-polynomial work studies definability of recurrence-value sets rather than embeddings of those values into an ordered Beatty subsequence \citep  {adamczewski2022,byszewski2016,byszewski2023}; Skolem--Mahler--Lech theory starts from a pre-existing recurrence and characterizes its zero or intersection sets \citep  {bell2005,derksen2005}. The present paper is therefore narrow by design: it claims a theorem only where the ordered-value problem can be proved directly.}}{4}{figure.10}\protected@file@percent }
\newlabel{fig:prior-art-matrix}{{2}{4}{Curated positioning against the actual nearby branches, rather than the raw lexical watchlist. The closest technical neighbors solve different tasks: quadratic Beatty decidability studies numeration-definable Beatty relations rather than exact value recurrences \citep {schaeffer2024,hieronymi2021,baranwal2021}; symbolic linear recurrence and central-set work study words, return words, or IP-set structure rather than the ordered integer value sequence \citep {durand1998,durand2000,durand2003,bucci2013}; generalized-polynomial work studies definability of recurrence-value sets rather than embeddings of those values into an ordered Beatty subsequence \citep {adamczewski2022,byszewski2016,byszewski2023}; Skolem--Mahler--Lech theory starts from a pre-existing recurrence and characterizes its zero or intersection sets \citep {bell2005,derksen2005}. The present paper is therefore narrow by design: it claims a theorem only where the ordered-value problem can be proved directly}{figure.10}{}}
\newlabel{fig:prior-art-matrix@cref}{{[figure][2][]2}{[1][2][]4}}
