\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Projected DEFLATE decompression throughput (MB/s) across five data categories. \textsc  {FlashDeflate}{} single-thread (1T) combines all Layer\nobreakspace  {}1 and Layer\nobreakspace  {}3 optimizations. \textsc  {FlashDeflate}{} 4-core (4T) adds Layer\nobreakspace  {}2 parallel block decompression. Baseline throughputs are from published benchmarks\nobreakspace  {}\citep  {turbobench2023}.\relax }}{11}{figure.caption.9}\protected@file@percent }
\newlabel{fig:throughput}{{3}{11}{Projected DEFLATE decompression throughput (MB/s) across five data categories. \sysname {} single-thread (1T) combines all Layer~1 and Layer~3 optimizations. \sysname {} 4-core (4T) adds Layer~2 parallel block decompression. Baseline throughputs are from published benchmarks~\citep {turbobench2023}.\relax }{figure.caption.9}{}}
