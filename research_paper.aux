\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Interleaving and offsets.} Left: the first $60$ row and column border terms, showing the exact strict alternation proved in Proposition\nobreakspace  {}\ref {prop:interleave}. Right: the sampled offset process $\delta _n=c_n-r_n$ up to $n=10^6$. The offset stays small on the explored horizon and never exceeds $24$, but the current theory does not convert this finite observation into a global theorem about the gap sequence.\relax }}{12}{figure.caption.2}\protected@file@percent }
\newlabel{fig:interleaving}{{2}{12}{\textbf {Interleaving and offsets.} Left: the first $60$ row and column border terms, showing the exact strict alternation proved in Proposition~\ref {prop:interleave}. Right: the sampled offset process $\delta _n=c_n-r_n$ up to $n=10^6$. The offset stays small on the explored horizon and never exceeds $24$, but the current theory does not convert this finite observation into a global theorem about the gap sequence.\relax }{figure.caption.2}{}}
