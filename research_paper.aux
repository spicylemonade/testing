\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Mega-scale double-mutant benchmark. StabOpt additive model (ESM-2 LLR sum) vs.\ published methods. N = 131{,}143 valid double-mutant predictions across 30 proteins.\relax }}{8}{table.caption.12}\protected@file@percent }
\newlabel{tab:megascale}{{2}{8}{Mega-scale double-mutant benchmark. StabOpt additive model (ESM-2 LLR sum) vs.\ published methods. N = 131{,}143 valid double-mutant predictions across 30 proteins.\relax }{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Per-protein Spearman correlations for double-mutant prediction on the Mega-scale dataset.} Proteins are sorted by sample size (largest to smallest). Blue bars: $\rho \geq 0.7$; yellow: $0.5 \leq \rho < 0.7$; red: $\rho < 0.5$. The dashed red line indicates the target threshold ($\rho = 0.5$); the dashed blue line shows the mean ($\rho = 0.744$). Overall $\rho = 0.809$ across all 131{,}143 double mutants.\relax }}{8}{figure.caption.13}\protected@file@percent }
\newlabel{fig:megascale_spearman}{{2}{8}{\textbf {Per-protein Spearman correlations for double-mutant prediction on the Mega-scale dataset.} Proteins are sorted by sample size (largest to smallest). Blue bars: $\rho \geq 0.7$; yellow: $0.5 \leq \rho < 0.7$; red: $\rho < 0.5$. The dashed red line indicates the target threshold ($\rho = 0.5$); the dashed blue line shows the mean ($\rho = 0.744$). Overall $\rho = 0.809$ across all 131{,}143 double mutants.\relax }{figure.caption.13}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Epistasis Analysis}{8}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Epistasis analysis.} (Left) Distribution of absolute pairwise epistasis magnitudes from the Mega-scale double mutants, showing that 64.2\% exceed 0.5\nobreakspace  {}\ensuremath  {\text  {kcal/mol}}{} and 39.7\% exceed 1.0\nobreakspace  {}\ensuremath  {\text  {kcal/mol}}{}. (Right) Epistasis magnitude as a function of $\ensuremath  {\text  {C}\alpha }$ distance, demonstrating the expected decay with distance that motivates the 10\nobreakspace  {}\r A{} structural proximity filter.\relax }}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:epistasis}{{3}{9}{\textbf {Epistasis analysis.} (Left) Distribution of absolute pairwise epistasis magnitudes from the Mega-scale double mutants, showing that 64.2\% exceed 0.5~\kcal {} and 39.7\% exceed 1.0~\kcal {}. (Right) Epistasis magnitude as a function of $\calpha $ distance, demonstrating the expected decay with distance that motivates the 10~\AA {} structural proximity filter.\relax }{figure.caption.14}{}}
