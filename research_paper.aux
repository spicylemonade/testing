\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Hardware counter comparison between scalar baseline, PyArrow, and SIMD parser on simple\_uniform (76.4\,MB). Left: estimated IPC. Center: branch mispredictions per 1{,}000 instructions. Right: bytes processed per cycle. The SIMD parser achieves a $3.1\times $ IPC improvement and $18.75\times $ reduction in branch mispredictions over the scalar baseline. Values are estimated from ISA analysis\nobreakspace  {}\citep  {fog2024microarchitecture}, calibrated against measured throughput.\relax }}{8}{figure.caption.7}\protected@file@percent }
\newlabel{fig:hardware}{{2}{8}{Hardware counter comparison between scalar baseline, PyArrow, and SIMD parser on simple\_uniform (76.4\,MB). Left: estimated IPC. Center: branch mispredictions per 1{,}000 instructions. Right: bytes processed per cycle. The SIMD parser achieves a $3.1\times $ IPC improvement and $18.75\times $ reduction in branch mispredictions over the scalar baseline. Values are estimated from ISA analysis~\citep {fog2024microarchitecture}, calibrated against measured throughput.\relax }{figure.caption.7}{}}
\newlabel{fig:hardware@cref}{{[figure][2][]2}{[1][7][]8}}
