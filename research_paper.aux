\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Record-gap growth and waiting times.} Left: the exact record-gap trajectory from the baseline million-step run. Right: the step increments between successive records. The record process clearly continues beyond the early $30{,}000$-step horizon, but the present data do not determine whether it stabilizes or diverges.\relax }}{13}{figure.caption.4}\protected@file@percent }
\newlabel{fig:trajectory}{{3}{13}{\textbf {Record-gap growth and waiting times.} Left: the exact record-gap trajectory from the baseline million-step run. Right: the step increments between successive records. The record process clearly continues beyond the early $30{,}000$-step horizon, but the present data do not determine whether it stabilizes or diverges.\relax }{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}What remains unresolved}{13}{subsection.8.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Failure modes and methodological limits}{13}{subsection.8.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Witness composition across record gaps.} Left: stacked witness signatures extracted from \artifact  {results/experiments/run\_1000000/record\_gap\_summary.json}. Every record gap contains exactly one forced axis-1 marker by Corollary\nobreakspace  {}\ref {cor:unitwitness}, but the rest of the interval does not compress into a stable small alphabet. Right: three summary shares. The singleton share remains large but does not increase toward a rigid certificate, the tiny-factor share decays, and the balanced-factor share rises sharply. Theorem\nobreakspace  {}\ref {prop:interleave} explains the one-point axis motif; the rest of the interval still lacks a theorem-level mechanism.\relax }}{14}{figure.caption.5}\protected@file@percent }
\newlabel{fig:composition}{{4}{14}{\textbf {Witness composition across record gaps.} Left: stacked witness signatures extracted from \artifact {results/experiments/run\_1000000/record\_gap\_summary.json}. Every record gap contains exactly one forced axis-1 marker by Corollary~\ref {cor:unitwitness}, but the rest of the interval does not compress into a stable small alphabet. Right: three summary shares. The singleton share remains large but does not increase toward a rigid certificate, the tiny-factor share decays, and the balanced-factor share rises sharply. Theorem~\ref {prop:interleave} explains the one-point axis motif; the rest of the interval still lacks a theorem-level mechanism.\relax }{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.4}Open questions}{14}{subsection.8.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Selected full witness hypergraphs for late baseline record gaps.} Left: total admissible factor pairs and the number of distinct row/column factors used in gaps $21$, $25$, $28$, and $30$, from \artifact  {results/analysis/full\_witness\_hypergraphs\_gap21\_25\_28\_30.json}. Right: multiplicity histograms for the same gaps. Even after full enumeration, the intervals remain singleton-dominated and use nearly as many distinct factors as there are witness pairs. This is evidence \emph  {against} a low-description frontier certificate.\relax }}{15}{figure.caption.6}\protected@file@percent }
\newlabel{fig:hypergraph}{{5}{15}{\textbf {Selected full witness hypergraphs for late baseline record gaps.} Left: total admissible factor pairs and the number of distinct row/column factors used in gaps $21$, $25$, $28$, and $30$, from \artifact {results/analysis/full\_witness\_hypergraphs\_gap21\_25\_28\_30.json}. Right: multiplicity histograms for the same gaps. Even after full enumeration, the intervals remain singleton-dominated and use nearly as many distinct factors as there are witness pairs. This is evidence \emph {against} a low-description frontier certificate.\relax }{figure.caption.6}{}}
