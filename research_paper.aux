\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Exact identities behind the archived update-order runs.} Left: the \texttt  {row\_immediate} sequence pair lies exactly on the diagonal when plotted against the baseline, because Proposition\nobreakspace  {}\ref {prop:rowimmediate} proves that the rule is identical to the original recurrence. Right: the \texttt  {column\_immediate} pair lies exactly on the axis-swapped diagonal because Proposition\nobreakspace  {}\ref {prop:swap} proves that it simply exchanges the roles of the two border sequences. These runs are therefore code-level consistency checks, not genuinely new robustness experiments.\relax }}{16}{figure.caption.7}\protected@file@percent }
\newlabel{fig:variants}{{6}{16}{\textbf {Exact identities behind the archived update-order runs.} Left: the \texttt {row\_immediate} sequence pair lies exactly on the diagonal when plotted against the baseline, because Proposition~\ref {prop:rowimmediate} proves that the rule is identical to the original recurrence. Right: the \texttt {column\_immediate} pair lies exactly on the axis-swapped diagonal because Proposition~\ref {prop:swap} proves that it simply exchanges the roles of the two border sequences. These runs are therefore code-level consistency checks, not genuinely new robustness experiments.\relax }{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Distribution of all first-row gaps through the archived million-step run.} Left: exact frequencies of $g_n=r_{n+1}-r_n$ for $1\le n<10^6$. Right: the empirical survival function on a logarithmic vertical scale. The distribution is concentrated on moderate values but has a visible long tail; finite data alone do not distinguish a bounded tail from a slowly moving frontier.\relax }}{16}{figure.caption.8}\protected@file@percent }
\newlabel{fig:distribution}{{7}{16}{\textbf {Distribution of all first-row gaps through the archived million-step run.} Left: exact frequencies of $g_n=r_{n+1}-r_n$ for $1\le n<10^6$. Right: the empirical survival function on a logarithmic vertical scale. The distribution is concentrated on moderate values but has a visible long tail; finite data alone do not distinguish a bounded tail from a slowly moving frontier.\relax }{figure.caption.8}{}}
