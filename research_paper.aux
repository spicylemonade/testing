\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Why the no-go is informative}{17}{subsection.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Structured mod-$64$ precursor results. The toy $n=9$ ladder is too weak to support a mechanism claim because random controls also solve most starts. The decisive packet is the single real degraded order-$668$ seed, where \texttt  {parallel\_gain\_ca}{} and \texttt  {direct\_greedy}{} tie exactly on every load-bearing metric. This closes the flat seed-repair channel before the literal cellar reopen begins.\relax }}{18}{figure.caption.6}\protected@file@percent }
\newlabel{fig:h2-results}{{4}{18}{Structured mod-$64$ precursor results. The toy $n=9$ ladder is too weak to support a mechanism claim because random controls also solve most starts. The decisive packet is the single real degraded order-$668$ seed, where \CA {} and \DG {} tie exactly on every load-bearing metric. This closes the flat seed-repair channel before the literal cellar reopen begins.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Limitations}{18}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Executed literal cellar encoding. (a) A tail panel fixes a canonical prefix of length $B>h$ and leaves only a contiguous free tail. The matched static residual state stores the zero-padded assigned pair vector together with fixed left boundary bits, current right boundary bits, and remaining weight. (b) The cellar memory reads one suffix bit at a time, pushes a length-$1$ block, and merges equal-size trailing blocks into dyadic summaries. (c) Both the stack view and the static view feed the same exact completion oracle; the decomposition formula proved in Lemma\nobreakspace  {}\ref {lem:decomposition} shows why the boundary terms and suffix-internal terms are the only unresolved contributions.\relax }}{19}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cellar-mechanism}{{5}{19}{Executed literal cellar encoding. (a) A tail panel fixes a canonical prefix of length $B>h$ and leaves only a contiguous free tail. The matched static residual state stores the zero-padded assigned pair vector together with fixed left boundary bits, current right boundary bits, and remaining weight. (b) The cellar memory reads one suffix bit at a time, pushes a length-$1$ block, and merges equal-size trailing blocks into dyadic summaries. (c) Both the stack view and the static view feed the same exact completion oracle; the decomposition formula proved in Lemma~\ref {lem:decomposition} shows why the boundary terms and suffix-internal terms are the only unresolved contributions.\relax }{figure.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}What remains open}{19}{subsection.8.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Real-anchor stress packet for the literal cellar branch. Labels are abbreviated as follows: RW$30001$, RW$30004$, RW$30012$, and RW$30011$ are the four best recorded exact-$167/80$ target panels from the precursor sweep; SF0 and SF41 are single-flip seed projections; C3 and C5 are three- and five-flip seed projections.\relax }}{20}{table.caption.9}\protected@file@percent }
\newlabel{tab:realanchor}{{4}{20}{Real-anchor stress packet for the literal cellar branch. Labels are abbreviated as follows: RW$30001$, RW$30004$, RW$30012$, and RW$30011$ are the four best recorded exact-$167/80$ target panels from the precursor sweep; SF0 and SF41 are single-flip seed projections; C3 and C5 are three- and five-flip seed projections.\relax }{table.caption.9}{}}
