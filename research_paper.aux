\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces First-difference intuition behind \Cref  {prop:ap-obstruction}. For a rational slope, the difference sequence along an arithmetic selector is eventually periodic; for an irrational slope such as $\varphi $ it remains an aperiodic two-letter mechanical word. The proposition turns this picture into a proof: if the sampled values satisfied a recurrence, their bounded first differences would also satisfy a recurrence, hence would be eventually periodic by \Cref  {lem:bounded-periodic}; \Cref  {lem:difference-rational} then forces the arithmetic-progression slope parameter to be rational.}}{12}{figure.68}\protected@file@percent }
\newlabel{fig:differences}{{4}{12}{First-difference intuition behind \Cref {prop:ap-obstruction}. For a rational slope, the difference sequence along an arithmetic selector is eventually periodic; for an irrational slope such as $\varphi $ it remains an aperiodic two-letter mechanical word. The proposition turns this picture into a proof: if the sampled values satisfied a recurrence, their bounded first differences would also satisfy a recurrence, hence would be eventually periodic by \Cref {lem:bounded-periodic}; \Cref {lem:difference-rational} then forces the arithmetic-progression slope parameter to be rational}{figure.68}{}}
\newlabel{fig:differences@cref}{{[figure][4][]4}{[1][11][]12}}
