\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scaling comparison between vectorized brute-force ($O(N^2)$) and Barnes--Hut ($O(N \log N)$) algorithms. The left panel shows wall-clock time versus $N$; the right panel shows the number of force interactions. While the interaction count (right) confirms sub-quadratic Barnes--Hut scaling, Python interpreter overhead dominates wall-clock time (left) for the tree-based method. In production compiled codes, the Barnes--Hut curve would be below the brute-force curve for $N \gtrsim 10^3$.\relax }}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:scaling}{{2}{8}{Scaling comparison between vectorized brute-force ($O(N^2)$) and Barnes--Hut ($O(N \log N)$) algorithms. The left panel shows wall-clock time versus $N$; the right panel shows the number of force interactions. While the interaction count (right) confirms sub-quadratic Barnes--Hut scaling, Python interpreter overhead dominates wall-clock time (left) for the tree-based method. In production compiled codes, the Barnes--Hut curve would be below the brute-force curve for $N \gtrsim 10^3$.\relax }{figure.caption.15}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Force algorithm performance comparison. Interaction counts and RMS relative force error for Barnes--Hut ($\theta = 0.5$) versus vectorized brute force. Bold indicates the best value in each column.\relax }}{8}{table.caption.16}\protected@file@percent }
\newlabel{tab:scaling}{{4}{8}{Force algorithm performance comparison. Interaction counts and RMS relative force error for Barnes--Hut ($\theta = 0.5$) versus vectorized brute force. Bold indicates the best value in each column.\relax }{table.caption.16}{}}
\newlabel{fig:kepler_drift}{{3a}{8}{Kepler orbit (1000 time units)\relax }{figure.caption.17}{}}
\newlabel{sub@fig:kepler_drift}{{a}{8}{Kepler orbit (1000 time units)\relax }{figure.caption.17}{}}
\newlabel{fig:pyth_drift}{{3b}{8}{Pythagorean 3-body (10 time units)\relax }{figure.caption.17}{}}
\newlabel{sub@fig:pyth_drift}{{b}{8}{Pythagorean 3-body (10 time units)\relax }{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Energy drift $|\Delta E / E_0|$ comparison across integrators. (a)\nobreakspace  {}On the Kepler orbit, the Yoshida integrator maintains drift at $\sim 10^{-10}$, approximately $3600\times $ better than leapfrog ($\sim 10^{-6}$) and $\sim 10^{6}\times $ better than Euler ($\sim 10^{-4}$). (b)\nobreakspace  {}On the Pythagorean 3-body problem, Yoshida achieves near-machine-precision conservation ($\sim 10^{-13}$) while Euler shows visible secular drift.\relax }}{8}{figure.caption.17}\protected@file@percent }
\newlabel{fig:integrator_kepler}{{3}{8}{Energy drift $|\Delta E / E_0|$ comparison across integrators. (a)~On the Kepler orbit, the Yoshida integrator maintains drift at $\sim 10^{-10}$, approximately $3600\times $ better than leapfrog ($\sim 10^{-6}$) and $\sim 10^{6}\times $ better than Euler ($\sim 10^{-4}$). (b)~On the Pythagorean 3-body problem, Yoshida achieves near-machine-precision conservation ($\sim 10^{-13}$) while Euler shows visible secular drift.\relax }{figure.caption.17}{}}
