\citation{maskov2006,allouche2018}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Claim-sensitive ablations requested by the verification audit. Left: raising the search ceiling from $d\le 4$ to $d\le 6$ and $d\le 8$ adds no new exact-certified case, but it converts many former \texttt  {no\_candidate} rows into higher-order short-window fits and modular-shadow failures. This is why the paper does not infer new mathematics from a larger order cap alone. Right: longer holdouts. The four certified quadratic-convergent identities remain exact through lengths $40$, $80$, $160$, and $320$; the unresolved Fibonacci/Pell quadratic cases also retain exact holdouts empirically; the three plastic prefix fits fail by $40$, and $\texttt  {salem\_quartic / ost\_suffix\_001}$ fails by $80$.}}{20}{figure.95}\protected@file@percent }
\newlabel{fig:ablations}{{7}{20}{Claim-sensitive ablations requested by the verification audit. Left: raising the search ceiling from $d\le 4$ to $d\le 6$ and $d\le 8$ adds no new exact-certified case, but it converts many former \texttt {no\_candidate} rows into higher-order short-window fits and modular-shadow failures. This is why the paper does not infer new mathematics from a larger order cap alone. Right: longer holdouts. The four certified quadratic-convergent identities remain exact through lengths $40$, $80$, $160$, and $320$; the unresolved Fibonacci/Pell quadratic cases also retain exact holdouts empirically; the three plastic prefix fits fail by $40$, and $\texttt {salem\_quartic / ost\_suffix\_001}$ fails by $80$}{figure.95}{}}
\newlabel{fig:ablations@cref}{{[figure][7][]7}{[1][18][]20}}
\citation{maskov2006,allouche2018}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Representative holdout-length ablation. Abbreviations: \ensuremath  {\mathrm  {EX}}= exact certified, \ensuremath  {\mathrm  {EH}}= exact holdout without structural certificate, \ensuremath  {\mathrm  {PF}}= positive-density prefix fit, \ensuremath  {\mathrm  {SF}}= selector-shadow failure. Grouped rows indicate that the two Fibonacci-type quadratic cases and the two Pell-type quadratic cases behave identically across the full $20/40/80/160/320$ follow-up.}}{21}{table.96}\protected@file@percent }
\newlabel{tab:holdouts}{{3}{21}{Representative holdout-length ablation. Abbreviations: \Exact = exact certified, \Hold = exact holdout without structural certificate, \Prefix = positive-density prefix fit, \Shadow = selector-shadow failure. Grouped rows indicate that the two Fibonacci-type quadratic cases and the two Pell-type quadratic cases behave identically across the full $20/40/80/160/320$ follow-up}{table.96}{}}
