\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Precursor $\mathrm  {H1}$ results on the solved $4\times 79$ control and the exact $167/80$ target. The top row reports mean best distance with bootstrap $95\%$ intervals; the bottom row gives paired seed-level comparisons between \texttt  {parallel\_gain\_ca}{} and \texttt  {direct\_greedy}{}. The literal cellar reopen is motivated precisely because these same-space local-update rules do not survive this matched-control test.\relax }}{16}{figure.caption.4}\protected@file@percent }
\newlabel{fig:h1-results}{{2}{16}{Precursor $\mathrm {H1}$ results on the solved $4\times 79$ control and the exact $167/80$ target. The top row reports mean best distance with bootstrap $95\%$ intervals; the bottom row gives paired seed-level comparisons between \CA {} and \DG {}. The literal cellar reopen is motivated precisely because these same-space local-update rules do not survive this matched-control test.\relax }{figure.caption.4}{}}
