\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Systematic comparison of all approaches against the state of the art. Dashed lines indicate the current best rigorous bounds. (a)\nobreakspace  {}Lower bounds: the DFA certificate method\nobreakspace  {}\citep  {H2024} dominates; our frog dynamics bound is valid but weaker. (b)\nobreakspace  {}Upper bounds: Lueker's eigenvalue method\nobreakspace  {}\citep  {L2009} remains unmatched; entropy bounds are structurally limited.\relax }}{9}{figure.caption.23}\protected@file@percent }
\newlabel{fig:comparison}{{3}{9}{Systematic comparison of all approaches against the state of the art. Dashed lines indicate the current best rigorous bounds. (a)~Lower bounds: the DFA certificate method~\citep {H2024} dominates; our frog dynamics bound is valid but weaker. (b)~Upper bounds: Lueker's eigenvalue method~\citep {L2009} remains unmatched; entropy bounds are structurally limited.\relax }{figure.caption.23}{}}
