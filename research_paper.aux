\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Gravitational collapse of $N=200$ bodies from a uniform disk. Panels show the spatial distribution at $t=0$ (initial uniform distribution), $t=500\,\Delta t$ (onset of contraction), $t=1000\,\Delta t$ (post-collapse core with ejected bodies), and $t=2000\,\Delta t$ (relaxed core with dispersed halo). The measured collapse time is within 6\% of the analytical free-fall prediction (Eq.\nobreakspace  {}\ref {eq:freefall}).\relax }}{10}{figure.caption.16}\protected@file@percent }
\newlabel{fig:collapse}{{5}{10}{Gravitational collapse of $N=200$ bodies from a uniform disk. Panels show the spatial distribution at $t=0$ (initial uniform distribution), $t=500\,\dt $ (onset of contraction), $t=1000\,\dt $ (post-collapse core with ejected bodies), and $t=2000\,\dt $ (relaxed core with dispersed halo). The measured collapse time is within 6\% of the analytical free-fall prediction (Eq.~\ref {eq:freefall}).\relax }{figure.caption.16}{}}
