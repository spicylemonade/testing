\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Frozen \textsc  {H1} corridor pilot. \textbf  {a}, the saved level-$1$ identity word. \textbf  {b}, its exact compiled corridor instance: one singleton seed at the left boundary, empty initial solved set, one nonzero top-row label, zero bottom row, and constant vertical label. This is precisely the setting of Corollary\nobreakspace  {}\ref {cor:h1}. The figure remains relevant even after Phase 6 because it visualizes the pilot route that first failed by proof.\relax }}{17}{figure.caption.11}\protected@file@percent }
\newlabel{fig:h1-grammar}{{2}{17}{Frozen \textsc {H1} corridor pilot. \textbf {a}, the saved level-$1$ identity word. \textbf {b}, its exact compiled corridor instance: one singleton seed at the left boundary, empty initial solved set, one nonzero top-row label, zero bottom row, and constant vertical label. This is precisely the setting of Corollary~\ref {cor:h1}. The figure remains relevant even after Phase 6 because it visualizes the pilot route that first failed by proof.\relax }{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The two formal obstructions proved in Section\nobreakspace  {}\ref {sec:theory}. \textbf  {a}, the one-seed obstruction: every generated relation has total label in the rank-one lattice generated by the unique seed, but rule\nobreakspace  {}2 requires a nonzero anti-diagonal singleton. \textbf  {b}, the passive-middle row-quotient obstruction: in the height-$3$ lift, every middle-row contribution is a multiple of the vertical label $c$, while the middle row must eventually produce an anti-diagonal singleton to force. The first panel explains the Phase 4 \textsc  {H1} failure; the second anticipates the Phase 6 geometry-lift failure.\relax }}{17}{figure.caption.12}\protected@file@percent }
\newlabel{fig:obstruction}{{3}{17}{The two formal obstructions proved in Section~\ref {sec:theory}. \textbf {a}, the one-seed obstruction: every generated relation has total label in the rank-one lattice generated by the unique seed, but rule~2 requires a nonzero anti-diagonal singleton. \textbf {b}, the passive-middle row-quotient obstruction: in the height-$3$ lift, every middle-row contribution is a multiple of the vertical label $c$, while the middle row must eventually produce an anti-diagonal singleton to force. The first panel explains the Phase 4 \textsc {H1} failure; the second anticipates the Phase 6 geometry-lift failure.\relax }{figure.caption.12}{}}
