\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Quantitative rigidity of the exhaustive \(2\times 2\) audit.} Left: only \(48\) of \(44{,}608\) witnesses are exact-valid. Middle: every exact-valid class has score \(7/4\), so the score histogram has a single bar. Right: the trace-signature histogram has four bins, each of size \(12\), one for each choice of first forced corner. Error bars have zero width because the data come from a complete finite enumeration.\relax }}{18}{figure.caption.6}\protected@file@percent }
\newlabel{fig:rigidity}{{4}{18}{\textbf {Quantitative rigidity of the exhaustive \(2\times 2\) audit.} Left: only \(48\) of \(44{,}608\) witnesses are exact-valid. Middle: every exact-valid class has score \(7/4\), so the score histogram has a single bar. Right: the trace-signature histogram has four bins, each of size \(12\), one for each choice of first forced corner. Error bars have zero width because the data come from a complete finite enumeration.\relax }{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Logged larger-family exact search frontier.} The second column uses Lemma\nobreakspace  {}\ref {lem:stripscore}: every listed family would already beat the prompt threshold if it forced all vertices. The failures are therefore structural, not score-accounting failures. The final two columns are exact maxima from the stored search logs rather than means over repeated runs, so no confidence interval is available beyond the exact reported maximum.\relax }}{18}{table.caption.9}\protected@file@percent }
\newlabel{tab:largersearch}{{3}{18}{\textbf {Logged larger-family exact search frontier.} The second column uses Lemma~\ref {lem:stripscore}: every listed family would already beat the prompt threshold if it forced all vertices. The failures are therefore structural, not score-accounting failures. The final two columns are exact maxima from the stored search logs rather than means over repeated runs, so no confidence interval is available beyond the exact reported maximum.\relax }{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Current admissible frontier}{18}{subsection.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Mode decomposition behind the width-\(2\) obstruction.} Rail generators transport only column-symmetric information into a fresh width-\(2\) column. The only antisymmetric generator native to that column is the single rung label \(v_j\). A first singleton force would require the diagonal antisymmetric direction \(A_j(1,-1)\), which is unavailable because no nonzero witness label is parallel to \((1,-1)\). This is the structural reason that a seedless fresh column cannot ignite.\relax }}{19}{figure.caption.7}\protected@file@percent }
\newlabel{fig:cover}{{5}{19}{\textbf {Mode decomposition behind the width-\(2\) obstruction.} Rail generators transport only column-symmetric information into a fresh width-\(2\) column. The only antisymmetric generator native to that column is the single rung label \(v_j\). A first singleton force would require the diagonal antisymmetric direction \(A_j(1,-1)\), which is unavailable because no nonzero witness label is parallel to \((1,-1)\). This is the structural reason that a seedless fresh column cannot ignite.\relax }{figure.caption.7}{}}
