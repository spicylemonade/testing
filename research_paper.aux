\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Projected ablation study on \texttt  {twitter.json}. Each bar adds one optimization atop the previous. The multiplicative stack of four orthogonal improvements compounds from 1.0$\times $ (baseline) to 1.57$\times $ (conservative combined estimate). The individual factors multiply optimistically to 1.77$\times $; the conservative combined estimate accounts for interaction effects.\relax }}{9}{figure.caption.9}\protected@file@percent }
\newlabel{fig:ablation}{{6}{9}{Projected ablation study on \texttt {twitter.json}. Each bar adds one optimization atop the previous. The multiplicative stack of four orthogonal improvements compounds from 1.0$\times $ (baseline) to 1.57$\times $ (conservative combined estimate). The individual factors multiply optimistically to 1.77$\times $; the conservative combined estimate accounts for interaction effects.\relax }{figure.caption.9}{}}
