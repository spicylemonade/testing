\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Grouped success counts for the 24-case primary startup matrix. Each row is one design from $\mathcal  {D}_{\mathrm  {ctx}}$, and each column block groups the same deterministic cases by polarity, impedance ratio, or ramp rate. Every row contains the same aggregate outcome: $17/24$ startups. This figure is important precisely because it is a null result. It rules out any honest claim that the earlier source-aware controllers widened the startup envelope of the chosen helper-free model.\relax }}{17}{figure.caption.5}\protected@file@percent }
\newlabel{fig:primary}{{3}{17}{Grouped success counts for the 24-case primary startup matrix. Each row is one design from $\mathcal {D}_{\mathrm {ctx}}$, and each column block groups the same deterministic cases by polarity, impedance ratio, or ramp rate. Every row contains the same aggregate outcome: $17/24$ startups. This figure is important precisely because it is a null result. It rules out any honest claim that the earlier source-aware controllers widened the startup envelope of the chosen helper-free model.\relax }{figure.caption.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Results}{17}{section.7}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.1}Context Evidence Rejects the Broad Ranking Story}{17}{subsection.7.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Context evidence that motivated the DEEPEN lane. The startup-matrix tie kills any broad envelope-expansion claim. The repaired falsifier suite exposes a frontier rather than a champion: no design clears all ten attacks, and all five fail the dual-collapse case \texttt  {fa\_006}. The numbers in this table are exact within the simulated model because the underlying runs are deterministic rather than sampled.\relax }}{18}{table.caption.6}\protected@file@percent }
\newlabel{tab:context}{{3}{18}{Context evidence that motivated the DEEPEN lane. The startup-matrix tie kills any broad envelope-expansion claim. The repaired falsifier suite exposes a frontier rather than a champion: no design clears all ten attacks, and all five fail the dual-collapse case \texttt {fa\_006}. The numbers in this table are exact within the simulated model because the underlying runs are deterministic rather than sampled.\relax }{table.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.2}Near-Tie Matrix Reveals a Temporal-Separability Law}{18}{subsection.7.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Expanded 10-case falsifier matrix for the context pack. Each cell reports deterministic startup success or failure and the load-bearing diagnostic for that case. The row pattern is the important one. \textsc  {TC-Ranked}is strongest at $9/10$, but no design is perfect and all five fail the dual-collapse case \texttt  {fa\_006}. \textsc  {Blind Packet}and \textsc  {Nonaware}both collapse on the mixed-conflict and leak-path separators, while \textsc  {Fixed}alone breaks on \texttt  {fa\_001}. This context figure is why the final paper does not ask ``which fixed ranking law is best overall?'' but instead asks whether there is any bounded regime in which a controller should rank at all.\relax }}{19}{figure.caption.7}\protected@file@percent }
\newlabel{fig:falsifier}{{4}{19}{Expanded 10-case falsifier matrix for the context pack. Each cell reports deterministic startup success or failure and the load-bearing diagnostic for that case. The row pattern is the important one. \TCRanked is strongest at $9/10$, but no design is perfect and all five fail the dual-collapse case \texttt {fa\_006}. \Blind and \Nonaware both collapse on the mixed-conflict and leak-path separators, while \Fixed alone breaks on \texttt {fa\_001}. This context figure is why the final paper does not ask ``which fixed ranking law is best overall?'' but instead asks whether there is any bounded regime in which a controller should rank at all.\relax }{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces DEEPEN near-tie core matrix. The design law is encoded row-by-row. On static near ties, \textsc  {Confidence-Gated}effectively stays blind. On late-arrival near ties, it commits and recovers part of the delay paid by the blind baseline. \textsc  {TC-Ranked}remains faster in both families, which blocks any best-overall claim.\relax }}{19}{table.caption.9}\protected@file@percent }
\newlabel{tab:deepen-core}{{4}{19}{DEEPEN near-tie core matrix. The design law is encoded row-by-row. On static near ties, \Confidence effectively stays blind. On late-arrival near ties, it commits and recovers part of the delay paid by the blind baseline. \TCRanked remains faster in both families, which blocks any best-overall claim.\relax }{table.caption.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.3}The Same-Scaffold No-Packet Control Exposes the Frontier}{19}{subsection.7.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Metric-contract repair for the context pack. The gray bars are the legacy full-window integrals, which continue to count controller activity after handoff and are therefore not appropriate for startup claims. The green bars are the repaired pre-handoff integrals used in this paper. The repair matters conceptually and numerically: it restores the correct ordering and allows the later DEEPEN controller to be compared under the same accounting path.\relax }}{20}{figure.caption.8}\protected@file@percent }
\newlabel{fig:accounting}{{5}{20}{Metric-contract repair for the context pack. The gray bars are the legacy full-window integrals, which continue to count controller activity after handoff and are therefore not appropriate for startup claims. The green bars are the repaired pre-handoff integrals used in this paper. The repair matters conceptually and numerically: it restores the correct ordering and allows the later DEEPEN controller to be compared under the same accounting path.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.4}Theory and Measurement Agree on What the Controller Is Paying For}{20}{subsection.7.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Central DEEPEN figure. Left panel: median explicit handoff times for the static and late near-tie families. The labels above the \textsc  {Confidence-Gated}bars report commit counts. Static near ties produce $0/6$ commits and essentially no gain over \textsc  {Blind Packet}; late-arrival near ties produce $6/6$ commits and a substantial median gain. Right panel: decisive same-scaffold control frontier on the four $V_B-V_A=\SI {3}{\milli \volt }$ cases. \textsc  {Blind Merge}is fastest but incurs measurable wrong-way energy, \textsc  {Blind Packet}is slowest but leak-free, and \textsc  {Confidence-Gated}occupies the middle of the frontier while preserving zero measured backdrive. The figure is the paper's core empirical result: the useful regime is temporal separability, not static ranking.\relax }}{21}{figure.caption.10}\protected@file@percent }
\newlabel{fig:deepen}{{6}{21}{Central DEEPEN figure. Left panel: median explicit handoff times for the static and late near-tie families. The labels above the \Confidence bars report commit counts. Static near ties produce $0/6$ commits and essentially no gain over \Blind ; late-arrival near ties produce $6/6$ commits and a substantial median gain. Right panel: decisive same-scaffold control frontier on the four $V_B-V_A=\SI {3}{\milli \volt }$ cases. \Merge is fastest but incurs measurable wrong-way energy, \Blind is slowest but leak-free, and \Confidence occupies the middle of the frontier while preserving zero measured backdrive. The figure is the paper's core empirical result: the useful regime is temporal separability, not static ranking.\relax }{figure.caption.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.5}Sampled Robustness Preserves the Corrected Separators}{21}{subsection.7.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Decisive same-scaffold control frontier. These rows use only the four DEEPEN control cases where \textsc  {Blind Merge}was explicitly executed. The frontier is the strongest bounded tradeoff supported by the paper: packet isolation preserves zero backdrive, while removing it buys speed at the cost of wrong-way energy.\relax }}{22}{table.caption.11}\protected@file@percent }
\newlabel{tab:frontier}{{5}{22}{Decisive same-scaffold control frontier. These rows use only the four DEEPEN control cases where \Merge was explicitly executed. The frontier is the strongest bounded tradeoff supported by the paper: packet isolation preserves zero backdrive, while removing it buys speed at the cost of wrong-way energy.\relax }{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Wilson 95\% intervals for four context cases rerun with 24 randomized samples per design-case. The figure is not a full DEEPEN robustness claim; the near-tie matrix was not rerun under the same Monte Carlo envelope. Instead, it verifies that the corrected context separators survive modest scripted parameter jitter. \textsc  {Fixed}remains broken on \texttt  {fa\_001}, \textsc  {Blind Packet}and \textsc  {Nonaware}remain broken on \texttt  {fa\_005}, \textsc  {TC-Ranked}and \textsc  {RC-Ranked}remain intact on both sampled separators, and \textsc  {Blind Merge}exhibits additional fragility despite its faster deterministic frontier point.\relax }}{22}{figure.caption.12}\protected@file@percent }
\newlabel{fig:robustness}{{7}{22}{Wilson 95\% intervals for four context cases rerun with 24 randomized samples per design-case. The figure is not a full DEEPEN robustness claim; the near-tie matrix was not rerun under the same Monte Carlo envelope. Instead, it verifies that the corrected context separators survive modest scripted parameter jitter. \Fixed remains broken on \texttt {fa\_001}, \Blind and \Nonaware remain broken on \texttt {fa\_005}, \TCRanked and \RCRanked remain intact on both sampled separators, and \Merge exhibits additional fragility despite its faster deterministic frontier point.\relax }{figure.caption.12}{}}
